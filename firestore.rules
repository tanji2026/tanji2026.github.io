rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'tanji2026@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validContent(c) {
      return c is map
        && c.keys().hasOnly(['settings','projects','awards','news','topics'])
        && c.keys().hasAll(['settings','projects','awards','news','topics'])
        && c.settings is map
        && c.projects is list && c.projects.size() <= 300
        && c.awards is list && c.awards.size() <= 300
        && c.news is list && c.news.size() <= 300
        && c.topics is list && c.topics.size() <= 300;
    }
    function validDocument() {
      return request.resource.data.keys().hasOnly(['schemaVersion','revision','content','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['schemaVersion','revision','content','updatedAt','updatedBy'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && validContent(request.resource.data.content)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }
    match /site/public {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() && validDocument() && request.resource.data.revision == 1;
      allow update: if isAdmin() && validDocument()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /site/draft {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin() && validDocument() && request.resource.data.revision == 1;
      allow update: if isAdmin() && validDocument()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /history/{version} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validDocument();
      allow update, delete: if false;
    }
    match /inquiries/{id} {
      function validInquiry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','email','organization','subject','message','language','status','createdAt'])
          && d.keys().hasAll(['name','email','organization','subject','message','language','status','createdAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() <= 200 && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && d.organization is string && d.organization.size() <= 150
          && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 150
          && d.message is string && d.message.size() > 0 && d.message.size() <= 4000
          && d.language in ['zh','en'] && d.status == 'new' && d.createdAt == request.time;
      }
      allow create: if validInquiry();
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new','read'];
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
